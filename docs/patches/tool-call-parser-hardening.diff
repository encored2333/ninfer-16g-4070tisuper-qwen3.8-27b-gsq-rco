+// LOCAL (batch 2, A1-A4): lexicon repair for a region every strict attempt rejected. Two passes,
+// both position-gated to TAG BOUNDARIES (region start, or after a '>' with only whitespace
+// between), so prose and parameter values are never touched:
+//   1. drop `<|...|>` control-token residue sitting right before an opener,
+//   2. complete a bare `function=`/`invoke=`/`parameter=`/`param=` opener with its '<'.
+// The repaired region is returned only when it then opens a function whose name is declared
+// (exact, or the unique case-insensitive match of E1); empty means "leave everything as it was".
+std::string repair_tool_region(std::string_view region, const Contract& contract,
+                               std::size_t max_name_length) {
+    constexpr std::string_view kCtrlOpen  = "<|";
+    constexpr std::string_view kCtrlClose = "|>";
+    constexpr std::string_view kBareOpeners[] = {"function=", "invoke=", "parameter=", "param="};
+    constexpr std::string_view kTagOpeners[]  = {"<function",  "<invoke",    "<parameter",
+                                                 "<param",     "function=",  "invoke=",
+                                                 "parameter=", "param="};
+
+    const auto tag_boundary = [](std::string_view text, std::size_t pos) {
+        if (pos == 0) { return true; }
+        std::size_t back = pos;
+        while (back != 0 && is_format_whitespace(text[back - 1])) { --back; }
+        return back != 0 && text[back - 1] == '>';
+    };
+    const auto matches_any = [](std::string_view text, std::size_t pos,
+                                const auto& openers) {
+        return std::any_of(std::begin(openers), std::end(openers), [&](std::string_view opener) {
+            return starts_with_at(text, pos, opener);
+        });
+    };
+
+    std::string repaired;
+    repaired.reserve(region.size());
+    std::size_t pos = 0;
+    while (pos < region.size()) {
+        if (starts_with_at(region, pos, kCtrlOpen) && tag_boundary(region, pos)) {
+            const std::size_t close = region.find(kCtrlClose, pos + kCtrlOpen.size());
+            if (close != std::string_view::npos) {
+                std::size_t after = close + kCtrlClose.size();
+                while (after < region.size() && is_format_whitespace(region[after])) { ++after; }
+                if (after < region.size() && matches_any(region, after, kTagOpeners)) {
+                    pos = after;
+                    continue;
+                }
+            }
+        }
+        if (region[pos] != '<' && tag_boundary(region, pos) &&
+            matches_any(region, pos, kBareOpeners)) {
+            repaired.push_back('<');
+        }
+        repaired.push_back(region[pos]);
+        ++pos;
+    }
+    if (repaired == region) { return {}; }
+
+    std::size_t probe  = 0;
+    const TagForm* form = opened_function(repaired, probe);
+    if (form == nullptr) { return {}; }
+    std::size_t tag_end = 0;
+    const std::string_view name = tag_name(tag_header(repaired, probe, *form, tag_end));
+    if (!valid_function_name(name, max_name_length) ||
+        find_tool_contract(contract, name) == nullptr) {
+        return {};
+    }
+    return repaired;
+}
